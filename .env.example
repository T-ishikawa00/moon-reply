# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Future OpenAI integration - do not implement in Stage 3
OPENAI_API_KEY=
OPENAI_MODEL_JUDGMENT=
OPENAI_MODEL_DIAGNOSIS=

# Future payment integration - provider not selected yet
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=

# Production transactional email. Provider selection is declared below.
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Security / tokens
RESULT_TOKEN_SECRET=
REQUEST_TOKEN_SECRET=

# Development flags
ENABLE_MOCK_PAYMENT=false
ENABLE_MOCK_AI=false
ENABLE_EMAIL_LOG_ONLY=true
ENABLE_HUMAN_QA_MODE=true

# M2-P3 server-only runtime. OPENAI_API_KEY is declared above.
OPENAI_MODEL=gpt-5.6-luna
M2_INTERNAL_RUNTIME_ENABLED=false

# Customer Identity Auth Foundation. Server-only and fail closed by default.
CUSTOMER_AUTH_ENABLED=false
CUSTOMER_AUTH_GOOGLE_ENABLED=false
CUSTOMER_AUTH_EMAIL_OTP_ENABLED=false
PREPAYMENT_COMPUTE_BUDGET_ENABLED=false
PREPAYMENT_COMPUTE_WINDOW_SECONDS=
PREPAYMENT_COMPUTE_MAX_PROVIDER_INVOCATIONS=

# F006 global unpaid invocation units (not currency), with bounded concurrency.
# Required only when unpaid Provider work starts; Paid never reads this policy.
# Empty values fail closed; candidate limits in the Wave review do not activate it.
PREPAYMENT_GLOBAL_COMPUTE_WINDOW_SECONDS=
PREPAYMENT_GLOBAL_COMPUTE_MAX_PROVIDER_INVOCATIONS=
PREPAYMENT_GLOBAL_COMPUTE_MAX_CONCURRENT=

# F005 durable anonymous admission: all six values are required for intake.
# Policy: lib/assessment/production/anonymous-admission.ts. No permissive defaults.
# IP_SOURCE accepts only netlify_context; deployed ingress/context must be verified.
# Candidate limits and rationale belong to the Wave 3 review, not activation here.
ANONYMOUS_ADMISSION_IP_SOURCE=
ANONYMOUS_ADMISSION_WINDOW_SECONDS=
ANONYMOUS_ADMISSION_MAX_REQUESTS_PER_IP=
ANONYMOUS_ADMISSION_MAX_REQUESTS_GLOBAL=
ANONYMOUS_ADMISSION_MAX_INTAKES_PER_IP=
ANONYMOUS_ADMISSION_MAX_INTAKES_GLOBAL=
CUSTOMER_AUTH_EMERGENCY_STOP=false
CUSTOMER_AUTH_CONTINUATION_TTL_SECONDS=600
CUSTOMER_AUTH_RATE_LIMIT_MODE=
CUSTOMER_AUTH_RATE_LIMIT_MAX_REQUESTS=
CUSTOMER_AUTH_RATE_LIMIT_WINDOW_SECONDS=
CUSTOMER_AUTH_EMAIL_KEY_VERSION=v1

# Customer Support intake. Server-only, independent, and off by default.
CUSTOMER_SUPPORT_CASES_ENABLED=false
PURCHASE_SUPPORT_EMAIL_ENABLED=false
PURCHASE_SUPPORT_OPERATOR_EMAIL=

# Measurement R1. Server-only values; fail-closed and off by default.
# MEASUREMENT_DESTINATION_ENV is `test` or `production` and must match
# PAYMENT_PROVIDER_ENVIRONMENT (`test` or `live`) before any adapter is enabled.
MEASUREMENT_ENABLED=false
MEASUREMENT_TRANSACTION_SECRET=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
MEASUREMENT_DESTINATION_ENV=

# RC-1 production fulfillment. All server-only and fail closed by default.
ASSESSMENT_PRODUCTION_PREPARATION_ENABLED=false
ASSESSMENT_PRODUCTION_RUNTIME_ENABLED=false
ASSESSMENT_PRODUCTION_RESULT_ACCESS_ENABLED=false
ASSESSMENT_PRODUCTION_EMERGENCY_STOP=false

# RC-2 production payment + verified customer delivery. Server-only unless noted.
# Keep all activation flags false until Human review, provider setup, migration apply,
# secrets, rate-limit/WAF setup, and the RC-3 hard gate are complete.
PAYMENT_PRODUCTION_ENABLED=false
PAYMENT_EMERGENCY_STOP=false
PAYMENT_FULFILLMENT_PROCESSING_ENABLED=false
PAYMENT_FULFILLMENT_EMERGENCY_STOP=false
PAYMENT_FULFILLMENT_DISPATCH_SCHEDULED_ENABLED=false
PAYMENT_PROVIDER_ENVIRONMENT=
STRIPE_WEBHOOK_ENABLED=false
STRIPE_RECONCILIATION_ENABLED=false
STRIPE_RECONCILIATION_SCHEDULED_ENABLED=false
STRIPE_PAYPAY_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_EMERGENCY_STOP=false
TRANSACTIONAL_EMAIL_PROVIDER=unconfigured
EMAIL_VERIFICATION_SECRET_PEPPER=
EMAIL_ADDRESS_ENCRYPTION_KEY=
PURCHASE_STATUS_SIGNING_SECRET=
EMAIL_VERIFICATION_CHALLENGE_TTL_SECONDS=
TRUSTED_EMAIL_SESSION_TTL_SECONDS=
EMAIL_VERIFICATION_MAX_ATTEMPTS=
PAYMENT_FULFILLMENT_LEASE_SECONDS=
PAYMENT_ROUTE_RATE_LIMIT_MODE=
PAYMENT_ROUTE_RATE_LIMIT_MAX_REQUESTS=
PAYMENT_ROUTE_RATE_LIMIT_WINDOW_SECONDS=

# Operator Discord Notifications R1. Server-only, independent, and off by default.
# ACTIVE_FROM must be an ISO-8601 instant chosen immediately before the migration
# is applied. The webhook belongs to a private operator-only Discord channel.
DISCORD_OPERATOR_NOTIFICATIONS_ENABLED=false
DISCORD_OPERATOR_NOTIFICATIONS_EMERGENCY_STOP=false
DISCORD_OPERATOR_NOTIFICATIONS_ACTIVE_FROM=
DISCORD_OPERATOR_WEBHOOK_URL=
DISCORD_OPERATOR_ACTION_REQUIRED_USER_ID=
