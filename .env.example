# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Future OpenAI integration - do not implement in Stage 3
OPENAI_API_KEY=
OPENAI_MODEL_JUDGMENT=
OPENAI_MODEL_DIAGNOSIS=

# Future payment integration - provider not selected yet
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=

# Future email integration - provider not selected yet
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Security / tokens
RESULT_TOKEN_SECRET=
REQUEST_TOKEN_SECRET=

# Development flags
ENABLE_MOCK_PAYMENT=false
ENABLE_MOCK_AI=false
ENABLE_EMAIL_LOG_ONLY=true
ENABLE_HUMAN_QA_MODE=true

# M2-P3 server-only runtime. OPENAI_API_KEY is declared above.
OPENAI_MODEL=gpt-5.6-luna
SUPABASE_URL=
SUPABASE_SECRET_KEY=
M2_INTERNAL_RUNTIME_ENABLED=false

# RC-1 production fulfillment. All server-only and fail closed by default.
ASSESSMENT_PRODUCTION_PREPARATION_ENABLED=false
ASSESSMENT_PRODUCTION_RUNTIME_ENABLED=false
ASSESSMENT_PRODUCTION_RESULT_ACCESS_ENABLED=false
ASSESSMENT_PRODUCTION_EMERGENCY_STOP=false

# RC-2 production payment + verified customer delivery. Server-only unless noted.
# Keep all activation flags false until Human review, provider setup, migration apply,
# secrets, rate-limit/WAF setup, and the RC-3 hard gate are complete.
PAYMENT_PRODUCTION_ENABLED=false
PAYMENT_EMERGENCY_STOP=false
PAYMENT_FULFILLMENT_PROCESSING_ENABLED=false
PAYMENT_FULFILLMENT_EMERGENCY_STOP=false
PAYMENT_PROVIDER_ENVIRONMENT=
STRIPE_WEBHOOK_ENABLED=false
STRIPE_PAYPAY_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_EMERGENCY_STOP=false
TRANSACTIONAL_EMAIL_PROVIDER=unconfigured
EMAIL_VERIFICATION_SECRET_PEPPER=
EMAIL_ADDRESS_ENCRYPTION_KEY=
PURCHASE_STATUS_SIGNING_SECRET=
EMAIL_VERIFICATION_CHALLENGE_TTL_SECONDS=
TRUSTED_EMAIL_SESSION_TTL_SECONDS=
EMAIL_VERIFICATION_MAX_ATTEMPTS=
PAYMENT_FULFILLMENT_LEASE_SECONDS=
PAYMENT_ROUTE_RATE_LIMIT_MODE=
PAYMENT_ROUTE_RATE_LIMIT_MAX_REQUESTS=
PAYMENT_ROUTE_RATE_LIMIT_WINDOW_SECONDS=
