{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moon-reply.invalid/schemas/structured-intake-v4.schema.json",
  "title": "Moon Reply Runtime Structured Intake v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "relationship_stage",
    "user_goal",
    "timeline",
    "boundaries",
    "context",
    "observed_facts",
    "user_assumptions",
    "user_emotions",
    "material_unknowns",
    "safety_signals",
    "untrusted_embedded_instructions_detected",
    "context_inferences",
    "decision_facts",
    "writing_context"
  ],
  "properties": {
    "schema_version": {
      "const": "pipeline-schema-v4.0.0"
    },
    "relationship_stage": {
      "$ref": "#/$defs/relationship_stage"
    },
    "user_goal": {
      "enum": [
        "decide_send_or_wait",
        "reply_to_message",
        "prepare_message",
        "organize_relationship",
        "plan_next_three_days",
        "organize_emotions",
        "unknown"
      ]
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timeline_event"
      },
      "maxItems": 40
    },
    "boundaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/boundary"
      },
      "maxItems": 20
    },
    "context": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/context_item"
      },
      "maxItems": 30
    },
    "observed_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observed_fact"
      },
      "maxItems": 60
    },
    "user_assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subjective_item"
      },
      "maxItems": 30
    },
    "user_emotions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subjective_item"
      },
      "maxItems": 30
    },
    "material_unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material_unknown"
      },
      "maxItems": 30
    },
    "safety_signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/safety_signal"
      },
      "maxItems": 20
    },
    "untrusted_embedded_instructions_detected": {
      "type": "boolean"
    },
    "context_inferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/context_inference"
      },
      "maxItems": 30
    },
    "decision_facts": {
      "$ref": "#/$defs/decision_facts"
    },
    "writing_context": {
      "$ref": "#/$defs/writing_context"
    }
  },
  "$defs": {
    "source_ref": {
      "type": "string",
      "pattern": "^(input|followup):[A-Za-z0-9_.-]+$"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_ref"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "relationship_stage": {
      "enum": [
        "dating",
        "in_relationship",
        "ambiguous",
        "former_partner",
        "matching_app",
        "friend",
        "work_or_school",
        "other",
        "unknown"
      ]
    },
    "decision_field_path": {
      "enum": [
        "relationship_stage",
        "latest_direct_message.sender",
        "latest_direct_message.kind",
        "latest_direct_message.response_expectation",
        "latest_direct_message.user_reply_state",
        "latest_direct_message.sns_signal_only",
        "contact_state.unanswered_user_message_count",
        "contact_state.elapsed_since_latest_user_message_minutes",
        "contact_state.usual_cadence_relation",
        "contact_state.proposed_message_present",
        "boundary_state.kind",
        "boundary_state.status",
        "boundary_state.repeated_unanswered_contact",
        "practical_reason.kind",
        "practical_reason.active",
        "practical_reason.deadline"
      ]
    },
    "timeline_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence",
        "actor",
        "statement",
        "source_refs"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^E[0-9]{3}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "actor": {
          "enum": [
            "user",
            "other_person",
            "third_party",
            "unknown"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_id",
        "kind",
        "status",
        "statement",
        "source_refs"
      ],
      "properties": {
        "boundary_id": {
          "type": "string",
          "pattern": "^B[0-9]{3}$"
        },
        "kind": {
          "enum": [
            "no_contact",
            "temporary_distance",
            "blocked_or_restricted",
            "relationship_closed",
            "contact_channel",
            "other"
          ]
        },
        "status": {
          "enum": [
            "explicit",
            "inferred",
            "unknown"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        }
      }
    },
    "context_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "kind",
        "statement",
        "source_refs"
      ],
      "properties": {
        "context_id": {
          "type": "string",
          "pattern": "^C[0-9]{3}$"
        },
        "kind": {
          "enum": [
            "schedule",
            "usual_cadence",
            "relationship",
            "practical_need",
            "message_state",
            "other"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        }
      }
    },
    "observed_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "statement",
        "source_refs",
        "support"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "pattern": "^F[0-9]{3}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        },
        "support": {
          "enum": [
            "explicit",
            "normalized",
            "unknown"
          ]
        }
      }
    },
    "subjective_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "statement",
        "source_refs"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^[AM][0-9]{3}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        }
      }
    },
    "material_unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknown_code",
        "description",
        "material_to"
      ],
      "properties": {
        "unknown_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "material_to": {
          "type": "array",
          "items": {
            "enum": [
              "eligibility",
              "decision",
              "message_draft",
              "safety"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "safety_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_id",
        "reason_code",
        "status",
        "source_refs"
      ],
      "properties": {
        "signal_id": {
          "type": "string",
          "pattern": "^S[0-9]{3}$"
        },
        "reason_code": {
          "enum": [
            "self_harm",
            "harm_others",
            "dv_abuse_fear",
            "stalking_or_visit",
            "waiting_or_ambush",
            "threat_or_coercion",
            "minor_related",
            "doxxing",
            "surveillance",
            "illegal_conduct",
            "third_party_secret"
          ]
        },
        "status": {
          "enum": [
            "affirmative",
            "ambiguous",
            "negated"
          ]
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        }
      }
    },
    "context_inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inference_id",
        "field_path",
        "supporting_fact_ids",
        "source_refs",
        "rationale_summary"
      ],
      "properties": {
        "inference_id": {
          "type": "string",
          "pattern": "^I[0-9]{3}$"
        },
        "field_path": {
          "$ref": "#/$defs/decision_field_path"
        },
        "supporting_fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F[0-9]{3}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        },
        "rationale_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "decision_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "relationship_stage",
        "selected_requests",
        "latest_direct_message",
        "contact_state",
        "boundary_state",
        "practical_reason",
        "information_state"
      ],
      "properties": {
        "schema_version": {
          "const": "m2-p4-decision-facts-v2"
        },
        "relationship_stage": {
          "$ref": "#/$defs/relationship_stage"
        },
        "selected_requests": {
          "type": "array",
          "items": {
            "enum": [
              "decide_send_or_wait",
              "message_impact",
              "draft_message",
              "relationship",
              "next_three_days",
              "organize_emotions"
            ]
          },
          "uniqueItems": true
        },
        "latest_direct_message": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sender",
            "kind",
            "response_expectation",
            "user_reply_state",
            "sns_signal_only"
          ],
          "properties": {
            "sender": {
              "enum": [
                "user",
                "other_person",
                "none",
                "unknown"
              ]
            },
            "kind": {
              "enum": [
                "question",
                "schedule_coordination",
                "apology",
                "thanks_or_followup",
                "practical_information",
                "invitation",
                "closure_or_boundary",
                "social_acknowledgement",
                "other",
                "none",
                "unknown"
              ]
            },
            "response_expectation": {
              "enum": [
                "reasonable",
                "optional",
                "none",
                "unknown"
              ]
            },
            "user_reply_state": {
              "enum": [
                "not_replied",
                "replied",
                "not_applicable",
                "unknown"
              ]
            },
            "sns_signal_only": {
              "type": "boolean"
            }
          }
        },
        "contact_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unanswered_user_message_count",
            "elapsed_since_latest_user_message_minutes",
            "usual_cadence_relation",
            "proposed_message_present"
          ],
          "properties": {
            "unanswered_user_message_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 20
            },
            "elapsed_since_latest_user_message_minutes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "usual_cadence_relation": {
              "enum": [
                "within_usual",
                "beyond_usual",
                "unknown",
                "not_applicable"
              ]
            },
            "proposed_message_present": {
              "type": "boolean"
            }
          }
        },
        "boundary_state": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "status",
                "repeated_unanswered_contact"
              ],
              "properties": {
                "kind": {
                  "const": "none"
                },
                "status": {
                  "const": "none"
                },
                "repeated_unanswered_contact": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "status",
                "repeated_unanswered_contact"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "no_contact",
                    "temporary_distance",
                    "blocked_or_restricted",
                    "relationship_closed"
                  ]
                },
                "status": {
                  "const": "explicit"
                },
                "repeated_unanswered_contact": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "status",
                "repeated_unanswered_contact"
              ],
              "properties": {
                "kind": {
                  "const": "unknown"
                },
                "status": {
                  "const": "unknown"
                },
                "repeated_unanswered_contact": {
                  "const": false
                }
              }
            }
          ]
        },
        "practical_reason": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "active",
                "deadline"
              ],
              "properties": {
                "kind": {
                  "const": "none"
                },
                "active": {
                  "const": false
                },
                "deadline": {
                  "const": "none"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "active",
                "deadline"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "schedule_coordination",
                    "factual_correction",
                    "promised_information",
                    "logistics",
                    "thank_you",
                    "initial_apology",
                    "single_invitation"
                  ]
                },
                "active": {
                  "const": true
                },
                "deadline": {
                  "enum": [
                    "none",
                    "same_day",
                    "next_day",
                    "later",
                    "unknown"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "active",
                "deadline"
              ],
              "properties": {
                "kind": {
                  "const": "unknown"
                },
                "active": {
                  "const": false
                },
                "deadline": {
                  "const": "unknown"
                }
              }
            }
          ]
        },
        "information_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assessment_mode",
            "can_proceed_without_followup",
            "used_context_inference",
            "unresolved_fields"
          ],
          "properties": {
            "assessment_mode": {
              "const": "best_effort"
            },
            "can_proceed_without_followup": {
              "const": true
            },
            "used_context_inference": {
              "type": "boolean"
            },
            "unresolved_fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/decision_field_path"
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "writing_source_ref": {
      "type": "string",
      "pattern": "^(input|followup):[A-Za-z0-9_.-]+$"
    },
    "writing_source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/writing_source_ref"
      },
      "maxItems": 40,
      "uniqueItems": true
    },
    "writing_evidence_state": {
      "enum": [
        "explicit",
        "inferred",
        "unresolved"
      ]
    },
    "relationship_effect_class": {
      "enum": [
        "writing_only",
        "decision_material",
        "safety_material"
      ]
    },
    "romantic_stage_writing_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "effect_class",
        "evidence_state",
        "explicit_source_refs",
        "inferred_source_refs",
        "unresolved",
        "source_refs"
      ],
      "properties": {
        "value": {
          "enum": [
            "none",
            "new_acquaintance",
            "dating_before_relationship",
            "ambiguous",
            "partner",
            "former_partner",
            "unknown"
          ]
        },
        "effect_class": {
          "$ref": "#/$defs/relationship_effect_class"
        },
        "evidence_state": {
          "$ref": "#/$defs/writing_evidence_state"
        },
        "explicit_source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        },
        "inferred_source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        },
        "unresolved": {
          "type": "boolean"
        },
        "source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        }
      }
    },
    "social_role_writing_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "effect_class",
        "evidence_state",
        "explicit_source_refs",
        "inferred_source_refs",
        "unresolved",
        "source_refs"
      ],
      "properties": {
        "value": {
          "enum": [
            "stranger",
            "acquaintance",
            "friend",
            "close_friend",
            "work_contact",
            "school_contact",
            "other",
            "unknown"
          ]
        },
        "effect_class": {
          "$ref": "#/$defs/relationship_effect_class"
        },
        "evidence_state": {
          "$ref": "#/$defs/writing_evidence_state"
        },
        "explicit_source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        },
        "inferred_source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        },
        "unresolved": {
          "type": "boolean"
        },
        "source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        }
      }
    },
    "hierarchy_writing_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "effect_class",
        "evidence_state",
        "explicit_source_refs",
        "inferred_source_refs",
        "unresolved",
        "source_refs"
      ],
      "properties": {
        "value": {
          "enum": [
            "user_is_junior",
            "peer",
            "user_is_senior",
            "none",
            "unknown"
          ]
        },
        "effect_class": {
          "$ref": "#/$defs/relationship_effect_class"
        },
        "evidence_state": {
          "$ref": "#/$defs/writing_evidence_state"
        },
        "explicit_source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        },
        "inferred_source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        },
        "unresolved": {
          "type": "boolean"
        },
        "source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        }
      }
    },
    "familiarity_writing_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "effect_class",
        "evidence_state",
        "explicit_source_refs",
        "inferred_source_refs",
        "unresolved",
        "source_refs"
      ],
      "properties": {
        "value": {
          "enum": [
            "first_contact",
            "early",
            "developing",
            "established",
            "former",
            "unknown"
          ]
        },
        "effect_class": {
          "$ref": "#/$defs/relationship_effect_class"
        },
        "evidence_state": {
          "$ref": "#/$defs/writing_evidence_state"
        },
        "explicit_source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        },
        "inferred_source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        },
        "unresolved": {
          "type": "boolean"
        },
        "source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        }
      }
    },
    "communication_context_writing_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "effect_class",
        "evidence_state",
        "explicit_source_refs",
        "inferred_source_refs",
        "unresolved",
        "source_refs"
      ],
      "properties": {
        "value": {
          "enum": [
            "matching_app",
            "private",
            "work",
            "school",
            "mixed",
            "other",
            "unknown"
          ]
        },
        "effect_class": {
          "$ref": "#/$defs/relationship_effect_class"
        },
        "evidence_state": {
          "$ref": "#/$defs/writing_evidence_state"
        },
        "explicit_source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        },
        "inferred_source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        },
        "unresolved": {
          "type": "boolean"
        },
        "source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        }
      }
    },
    "observed_register_writing_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "effect_class",
        "evidence_state",
        "explicit_source_refs",
        "inferred_source_refs",
        "unresolved",
        "source_refs"
      ],
      "properties": {
        "value": {
          "enum": [
            "polite",
            "neutral_polite",
            "casual",
            "mixed",
            "unknown"
          ]
        },
        "effect_class": {
          "$ref": "#/$defs/relationship_effect_class"
        },
        "evidence_state": {
          "$ref": "#/$defs/writing_evidence_state"
        },
        "explicit_source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        },
        "inferred_source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        },
        "unresolved": {
          "type": "boolean"
        },
        "source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        }
      }
    },
    "relationship_dimensions": {
