    "explicit_user_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "kind",
        "bounded_summary",
        "source_refs"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "pattern": "^UC[0-9]{3}$"
        },
        "kind": {
          "enum": [
            "no_emoji",
            "no_self_invitation",
            "no_late_night_send",
            "no_phone_call",
            "no_private_contact_at_work",
            "no_followup_message",
            "keep_polite_register",
            "keep_casual_register",
            "custom_explicit_constraint"
          ]
        },
        "bounded_summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "source_refs": {
          "$ref": "#/$defs/writing_source_refs"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "custom_explicit_constraint"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "bounded_summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "no_emoji",
                  "no_self_invitation",
                  "no_late_night_send",
                  "no_phone_call",
                  "no_private_contact_at_work",
                  "no_followup_message",
                  "keep_polite_register",
                  "keep_casual_register"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "bounded_summary": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
