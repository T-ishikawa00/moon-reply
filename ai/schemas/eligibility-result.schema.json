{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moon-reply.invalid/schemas/eligibility-result.schema.json",
  "title": "Moon Reply Eligibility Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "eligibility",
    "question_codes",
    "material_gap_codes",
    "normal_flow_allowed",
    "payment_allowed",
    "report_generation"
  ],
  "properties": {
    "schema_version": {
      "const": "pipeline-schema-v1.0.0"
    },
    "eligibility": {
      "enum": [
        "ready",
        "needs_more_information",
        "safety_blocked"
      ]
    },
    "question_codes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question_code"
      },
      "uniqueItems": true,
      "maxItems": 3
    },
    "material_gap_codes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material_gap_code"
      },
      "uniqueItems": true
    },
    "normal_flow_allowed": {
      "type": "boolean"
    },
    "payment_allowed": {
      "type": "boolean"
    },
    "report_generation": {
      "enum": [
        "allowed",
        "prohibited"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eligibility": {
            "const": "needs_more_information"
          }
        },
        "required": [
          "eligibility"
        ]
      },
      "then": {
        "properties": {
          "question_codes": {
            "minItems": 1,
            "maxItems": 3
          },
          "normal_flow_allowed": {
            "const": false
          },
          "payment_allowed": {
            "const": false
          },
          "report_generation": {
            "const": "prohibited"
          }
        }
      },
      "else": {
        "properties": {
          "question_codes": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eligibility": {
            "const": "ready"
          }
        },
        "required": [
          "eligibility"
        ]
      },
      "then": {
        "properties": {
          "normal_flow_allowed": {
            "const": true
          },
          "payment_allowed": {
            "const": true
          },
          "report_generation": {
            "const": "allowed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eligibility": {
            "const": "safety_blocked"
          }
        },
        "required": [
          "eligibility"
        ]
      },
      "then": {
        "properties": {
          "normal_flow_allowed": {
            "const": false
          },
          "payment_allowed": {
            "const": false
          },
          "report_generation": {
            "const": "prohibited"
          }
        }
      }
    }
  ],
  "$defs": {
    "question_code": {
      "enum": [
        "Q_RELATIONSHIP_STAGE",
        "Q_LAST_MESSAGE_TIMELINE",
        "Q_UNANSWERED_COUNT_AND_TIME",
        "Q_EXACT_MESSAGE",
        "Q_ALREADY_REPLIED",
        "Q_USER_GOAL",
        "Q_RECENT_MESSAGE_SEQUENCE",
        "Q_UNANSWERED_USER_MESSAGE",
        "Q_LAST_CONTACT_TIME",
        "Q_UNANSWERED_COUNT_AND_DEADLINE",
        "Q_UNANSWERED_COUNT",
        "Q_CONTACT_TIME_RANGE",
        "Q_EXPLICIT_BOUNDARY",
        "Q_RELATIONSHIP_AND_LAST_CONTACT",
        "Q_LAST_MESSAGE_STATE",
        "Q_BOUNDARY_AND_GOAL",
        "Q_LAST_DIRECT_CONTACT",
        "Q_RELATIONSHIP_END_BOUNDARY",
        "Q_USUAL_CONTACT_CADENCE"
      ]
    },
    "material_gap_code": {
      "enum": [
        "active_deadline_missing",
        "contact_timeline_missing",
        "contradictory_timeline",
        "elapsed_time_missing",
        "explicit_boundary_unknown",
        "last_message_missing",
        "last_sender_missing",
        "relationship_stage_missing",
        "reply_status_unknown",
        "social_signal_only",
        "unanswered_count_missing",
        "user_goal_missing",
        "usual_cadence_missing"
      ]
    }
  }
}
