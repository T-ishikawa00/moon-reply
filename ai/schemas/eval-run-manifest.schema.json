{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moon-reply.invalid/schemas/eval-run-manifest.schema.json",
  "title": "Moon Reply Evaluation Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "started_at",
    "completed_at",
    "git_sha",
    "dataset",
    "versions",
    "provider",
    "parameters",
    "case_runs",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "eval-run-manifest-v1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{7,127}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "split",
        "case_count"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^eval-[a-z-]+-v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "split": {
          "enum": [
            "development",
            "holdout",
            "retired",
            "production_regression"
          ]
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "schema",
        "prompt",
        "validator",
        "safety",
        "renderer"
      ],
      "properties": {
        "policy": {
          "const": "decision-policy-v1.0.0"
        },
        "schema": {
          "const": "pipeline-schema-v1.0.0"
        },
        "prompt": {
          "const": "prompt-bundle-v1.0.0"
        },
        "validator": {
          "const": "validator-v1.0.0"
        },
        "safety": {
          "const": "safety-policy-v1.0.0"
        },
        "renderer": {
          "const": "report-renderer-v1.0.0"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "api_family",
        "requested_model",
        "returned_model",
        "store"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "api_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "requested_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "returned_model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "store": {
          "const": false
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature",
        "top_p",
        "max_output_tokens",
        "seed"
      ],
      "properties": {
        "temperature": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 2
        },
        "top_p": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "case_runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case_run"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "completed_count",
        "refusal_count",
        "terminal_failure_count",
        "gate_results",
        "estimated_cost"
      ],
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "completed_count": {
          "type": "integer",
          "minimum": 0
        },
        "refusal_count": {
          "type": "integer",
          "minimum": 0
        },
        "terminal_failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "gate_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gate_result"
          },
          "uniqueItems": true
        },
        "estimated_cost": {
          "$ref": "#/$defs/cost"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "token_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "cached_input_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cost": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "currency",
        "amount"
      ],
      "properties": {
        "currency": {
          "enum": [
            "USD",
            "JPY"
          ]
        },
        "amount": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "status",
        "failed_codes"
      ],
      "properties": {
        "gate": {
          "type": "string",
          "pattern": "^G[0-9]+(?:_[A-Z0-9_]+)?$"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "failed_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "case_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "response_id",
        "attempt",
        "latency_ms",
        "token_usage",
        "estimated_cost",
        "refusal",
        "gate_results"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^(REPLY|SEND|WAIT|PAUSE|INFO|SAFETY|BENIGN)-[0-9]{3}$"
        },
        "response_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "latency_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "token_usage": {
          "oneOf": [
            {
              "$ref": "#/$defs/token_usage"
            },
            {
              "type": "null"
            }
          ]
        },
        "estimated_cost": {
          "$ref": "#/$defs/cost"
        },
        "refusal": {
          "type": "boolean"
        },
        "gate_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gate_result"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
