  "failure_matrix": [
    {
      "failure_id": "BASE-PROVIDER-FAILURE",
      "condition": "PB-01 transport or Provider failure",
      "base_available": false,
      "candidate_available": "not_relevant",
      "candidate_safety_available": "not_relevant",
      "blocking": true,
      "behavior": "fail_closed",
      "downstream_provider_calls": 0
    },
    {
      "failure_id": "BASE-SCHEMA-FAILURE",
      "condition": "PB-01 output fails Base Schema",
      "base_available": false,
      "blocking": true,
      "behavior": "fail_closed",
      "downstream_provider_calls": 0
    },
    {
      "failure_id": "BASE-SOURCE-INTEGRITY-FAILURE",
      "condition": "Base output contains candidate source, candidate literal, or forbidden ownership",
      "base_available": false,
      "blocking": true,
      "behavior": "fail_closed",
      "safe_code": "M2_BASE_SOURCE_INTEGRITY_FAILED",
      "downstream_provider_calls": 0
    },
    {
      "failure_id": "CANDIDATE-ABSENT",
      "condition": "optional_message is null empty or whitespace after trim",
      "base_available": true,
      "candidate_provider_calls": 0,
      "candidate_analysis": null,
      "candidate_analysis_status": "absent",
      "candidate_safety_result": null,
      "optional_source_refs": 0,
      "blocking": false
    },
    {
      "failure_id": "CANDIDATE-NONSAFETY-ANALYSIS-INVALID",
      "condition": "Candidate Safety independently validates but one or more style intent or language fields do not",
      "base_available": true,
      "candidate_analysis": null,
      "candidate_analysis_status": "unavailable",
      "candidate_safety_result": "available",
      "blocking": false,
      "behavior": "continue_only_after_aggregate_safety_normal",
      "pb_04_fallback": "conservative_minimal_editing_only",
      "fabricated_candidate_semantics": 0
    },
    {
      "failure_id": "CANDIDATE-PROVIDER-NO-RESPONSE",
      "condition": "PB-01C fails before any independently valid Candidate Safety result exists",
      "base_available": true,
      "candidate_analysis": null,
      "candidate_analysis_status": "unavailable",
      "candidate_safety_result": null,
      "blocking": true,
      "behavior": "fail_closed_before_candidate_generation",
      "safe_code": "M2_CANDIDATE_SAFETY_UNAVAILABLE",
      "exception": "If deterministic Safety already yields needs_review or rejected return safety_blocked with its stricter response mode."
    },
    {
      "failure_id": "CANDIDATE-SAFETY-INVALID",
      "condition": "PB-01C returns candidate fields but candidate_safety_signals fail the bounded Safety contract",
      "base_available": true,
      "candidate_analysis": null,
      "candidate_analysis_status": "unavailable",
      "candidate_safety_result": null,
      "blocking": true,
      "behavior": "fail_closed_before_candidate_generation",
      "safe_code": "M2_CANDIDATE_SAFETY_UNAVAILABLE"
    },
    {
      "failure_id": "CANDIDATE-SOURCE-INTEGRITY-FAILURE",
      "condition": "PB-01C emits Base fact fields source refs IDs or sequence",
      "base_available": true,
      "candidate_analysis": null,
      "candidate_analysis_status": "unavailable",
      "blocking": true,
      "behavior": "reject_candidate_output",
      "safe_code": "M2_CANDIDATE_SOURCE_INTEGRITY_FAILED"
    },
    {
      "failure_id": "PB02-SAFETY-OUTPUT-INVALID",
      "condition": "PB-02 result cannot be aggregated",
      "blocking": true,
      "behavior": "fail_closed",
      "candidate_draft_generation": "prohibited"
    },
    {
      "failure_id": "AGGREGATE-SAFETY-NONNORMAL",
      "condition": "strictest aggregate classification is needs_review or rejected",
      "blocking": true,
      "behavior": "return_safety_blocked",
      "PB-04_through_PB-06_calls": 0,
      "candidate_draft_generation": "prohibited"
    },
    {
      "failure_id": "PB04-FALLBACK-POLICY-VIOLATION",
      "condition": "Fallback adds meaning facts commitment invitation affection question pressure or schedule",
      "blocking": true,
      "behavior": "fail_closed_before_report",
      "PB-05_and_PB-06_calls": 0
    },
    {
      "failure_id": "PB06-MAJOR-OR-CRITICAL",
      "condition": "A true application-adjudicated material major or critical semantic finding remains",
      "blocking": true,
      "behavior": "fail_closed",
      "validator_weakening_allowed": false
    }
  ],
  "blocking_boundary": {
    "always_blocking": [
      "base_stage_unavailable",
      "base_schema_invalid",
      "base_source_integrity_invalid",
      "candidate_present_and_candidate_safety_cannot_be_established",
      "aggregate_safety_not_normal",
      "PB_04_fallback_policy_violation",
      "true_material_PB_06_major_or_critical"
    ],
    "nonblocking_only_when_all_conditions_hold": [
      "base_stage_valid",
      "candidate_safety_result_independently_valid",
      "aggregate_safety_result_normal_allowed",
      "candidate_analysis_failure_is_limited_to_non_safety_fields",
      "candidate_analysis_is_null_not_fabricated",
      "PB_04_uses_conservative_minimal_editing",
      "PB_06_material_validation_passes"
    ]
  },
  "safety_blindness_assertions": {
    "deterministic_current_situation_inspection_preserved": true,
    "deterministic_optional_message_inspection_preserved": true,
    "candidate_semantic_safety_separate": true,
    "candidate_safety_merged_into_base_facts": false,
    "explicit_no_contact_cross_channel_check_required": true
