  "product_direction_doctrine": {
    "canonical_statement_ja": "月の返事は、恋の唯一の正解や相手の本心を断定するサービスではない。\n相談者が迷って動けないときに、\n今ある事実と複数の見方を整理し、\n今の時点で最も進みやすい方向を一つ示す鑑定ノートである。",
    "machine_readable_summary_en": "The product does not claim a unique romantic truth. It preserves facts, presents plausible interpretations, recommends one current direction, gives an immediate next step, and defines reassessment conditions.",
    "required_outcome_sequence": [
      "facts",
      "plausible_interpretations",
      "recommended_current_direction",
      "immediate_next_step",
      "reassessment_condition"
    ],
    "prohibited_framings": [
      "unsupported_inner_state_certainty",
      "future_guarantee",
      "occult_certainty",
      "one_label_is_the_truth",
      "forcing_ambiguous_human_language_into_one_artificial_interpretation",
      "direction_without_an_actionable_next_step",
      "advice_without_a_reassessment_condition"
    ],
    "japanese_product_summary": "事実は厳密に守る。解釈には幅を持たせる。その上で、相談者が今進みやすい方向を一つ示す。"
  },
