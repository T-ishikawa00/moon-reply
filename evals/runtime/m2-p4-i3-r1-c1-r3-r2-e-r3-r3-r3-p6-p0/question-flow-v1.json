  "follow_up_flows": {
    "business_only_scope": {
      "entry_classification": "needs_clarification",
      "questions": [
        {
          "code": "practical_permission_explicit",
          "customer_question": "業務・荷物・金銭など、必要な実務連絡が明確に許可されていますか。",
          "answer_options": [
            "yes",
            "no",
            "unknown"
          ],
          "required_answer": "yes"
        },
        {
          "code": "current_request_practical_scope_only",
          "customer_question": "今回の依頼は、許可された実務上の用件だけに完全に限定されていますか。",
          "answer_options": [
            "yes",
            "no",
            "unknown"
          ],
          "required_answer": "yes"
        }
      ],
      "resolution": {
        "all_yes": "eligible_business_only",
        "any_no": "blocked_no_purchase",
        "any_unknown": "needs_clarification",
        "unknown_unresolved": "blocked_no_purchase"
      },
      "eligible_constraints": [
        "assessment_and_draft_strictly_within_practical_scope",
        "no_romance_interpretation",
        "no_personal_invitation",
        "no_relationship_progression",
        "no_emotional_pressure_wording",
        "no_follow_up_outside_permitted_practical_matter"
      ]
    },
    "new_inbound_scope": {
      "entry_classification": "needs_clarification",
      "questions": [
        {
          "code": "reply_explicitly_invited",
          "customer_question": "新しいメッセージは、返答を明確に求めるか、返答してよいことを明確に示していますか。",
          "answer_options": [
            "yes",
            "no",
            "unknown"
          ],
          "required_answer": "yes"
        },
        {
          "code": "reply_limited_to_new_message_subject",
          "customer_question": "予定している返答は、その新しいメッセージの用件と範囲だけに限定されていますか。",
          "answer_options": [
            "yes",
            "no",
            "unknown"
          ],
          "required_answer": "yes"
        }
      ],
      "resolution": {
        "all_yes": "eligible_scoped_reply",
        "any_no": "blocked_no_purchase",
        "any_unknown": "needs_clarification",
        "unknown_unresolved": "blocked_no_purchase"
      },
      "eligible_constraints": [
        "reply_stays_within_new_inbound_subject_and_scope",
        "no_broader_relationship_or_contact_permission_inferred",
        "no_unrelated_follow_up"
      ]
    },
    "boundary_clarification": {
      "entry_classification": "needs_clarification",
      "purpose": "Resolve whether any no-contact, pause, channel restriction, closure, or narrow permission exists without guessing.",
      "unresolved_result": "blocked_no_purchase",
      "payment_available_while_unresolved": false
    }
  },
  "conflict_rule": {
