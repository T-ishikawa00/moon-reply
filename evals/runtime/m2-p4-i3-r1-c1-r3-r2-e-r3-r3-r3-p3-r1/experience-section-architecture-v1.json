  "required_emotional_journey": [
    {
      "step": 1,
      "outcome": "The customer feels that their anxiety was received."
    },
    {
      "step": 2,
      "outcome": "Their situation is restated in consultation-specific language."
    },
    {
      "step": 3,
      "outcome": "Observed facts and feared interpretations are separated."
    },
    {
      "step": 4,
      "outcome": "Uncertainty is bounded without listing every negative possibility."
    },
    {
      "step": 5,
      "outcome": "One present direction is given."
    },
    {
      "step": 6,
      "outcome": "A draft is provided when permitted and requested."
    },
    {
      "step": 7,
      "outcome": "One immediate action is made concrete."
    },
    {
      "step": 8,
      "outcome": "Observable reassessment conditions are given."
    },
    {
      "step": 9,
      "outcome": "The note closes with calm, non-generic aftercare."
    }
  ],
  "experience_sequence": [
    "理解された感覚",
    "安心",
    "納得",
    "行動"
  ],
  "rejected_sequence": [
    "結論",
    "操作指示",
    "終了"
  ],
  "core_experience_candidates": [
