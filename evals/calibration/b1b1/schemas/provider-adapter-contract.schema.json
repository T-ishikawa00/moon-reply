{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moon-reply.invalid/schemas/b1b1/provider-adapter-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "task_id",
    "execution_mode",
    "case_id",
    "requested_model",
    "model_role",
    "selected_for_product",
    "selected_for_baseline",
    "source_b0_contract_hash",
    "endpoint_path",
    "endpoint_host_bound",
    "stage_ids",
    "maximum_future_provider_calls",
    "actual_provider_calls",
    "api_spend_usd",
    "live_execution_authorized",
    "paid_run_authorized",
    "http_executor_implemented",
    "environment_secret_provider_implemented",
    "provider_sdk_used",
    "global_fetch_used",
    "interfaces",
    "pre_secret_check_order",
    "required_network_blocked_stop_code",
    "retry_allowed",
    "repair_allowed",
    "fallback_allowed",
    "batch_allowed",
    "pb_07_included",
    "fourteen_case_execution_allowed",
    "seventy_case_execution_allowed",
    "holdout_execution_allowed",
    "real_user_execution_allowed",
    "b1_b2_authorized"
  ],
  "properties": {
    "schema_version": {"const": "moon-reply-b1b1-provider-adapter-contract-v1"},
    "contract_version": {"const": "network-disabled-provider-adapter-v1.0.0"},
    "task_id": {"const": "M2-P2-B1-B1"},
    "execution_mode": {"const": "network_blocked_provider_adapter_test"},
    "case_id": {"const": "WAIT-003"},
    "requested_model": {"const": "gpt-5.6-luna"},
    "model_role": {"const": "cost_and_plumbing_calibration_candidate"},
    "selected_for_product": {"const": false},
    "selected_for_baseline": {"const": false},
    "source_b0_contract_hash": {"$ref": "#/$defs/sha256"},
    "endpoint_path": {"const": "/v1/responses"},
    "endpoint_host_bound": {"const": false},
    "stage_ids": {"$ref": "#/$defs/stages"},
    "maximum_future_provider_calls": {"const": 6},
    "actual_provider_calls": {"const": 0},
    "api_spend_usd": {"const": 0},
    "live_execution_authorized": {"const": false},
    "paid_run_authorized": {"const": false},
    "http_executor_implemented": {"const": false},
    "environment_secret_provider_implemented": {"const": false},
    "provider_sdk_used": {"const": false},
    "global_fetch_used": {"const": false},
    "interfaces": {"type": "object"},
    "pre_secret_check_order": {
      "type": "array",
      "prefixItems": [
        {"const": "request_contract"},
        {"const": "approval"},
        {"const": "network_interlock"},
        {"const": "budget"}
      ],
      "items": false
    },
    "required_network_blocked_stop_code": {"const": "LIVE_EXECUTION_NOT_AUTHORIZED"},
    "retry_allowed": {"const": false},
    "repair_allowed": {"const": false},
    "fallback_allowed": {"const": false},
    "batch_allowed": {"const": false},
    "pb_07_included": {"const": false},
    "fourteen_case_execution_allowed": {"const": false},
    "seventy_case_execution_allowed": {"const": false},
    "holdout_execution_allowed": {"const": false},
    "real_user_execution_allowed": {"const": false},
    "b1_b2_authorized": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stages": {
      "type": "array",
      "prefixItems": [
        {"const": "PB-01"},
        {"const": "PB-02"},
        {"const": "PB-03"},
        {"const": "PB-04"},
        {"const": "PB-05"},
        {"const": "PB-06"}
      ],
      "items": false
    }
  }
}
