{
  "schema_version": "moon-reply-calibration-artifact-contract-v1",
  "contract_version": "calibration-artifact-contract-v1.0.0",
  "repository_storage_default": false,
  "b0_creates_paid_run_directory": false,
  "default_conceptual_location": "%LOCALAPPDATA%\\moon-reply\\calibration-runs\\<run_id>\\",
  "required_files": [
    "run-manifest.json",
    "stage-records.json",
    "gate-results.json",
    "cost-summary.json",
    "calibration-summary.md",
    "outputs/PB-01.json",
    "outputs/PB-02.json",
    "outputs/PB-03.json",
    "outputs/PB-04.json",
    "outputs/PB-05.json",
    "outputs/PB-06.json"
  ],
  "allowed_evidence_fields": [
    "run_id",
    "fixture_case_id",
    "prompt_hashes",
    "schema_hashes",
    "contract_hash",
    "requested_model_id",
    "returned_model_id",
    "response_ids",
    "response_status",
    "usage.input_tokens",
    "usage.input_tokens_details.cached_tokens",
    "usage.output_tokens",
    "usage.output_tokens_details.reasoning_tokens",
    "usage.total_tokens",
    "latency_milliseconds",
    "schema_results",
    "gate_results",
    "usage-derived cost estimate",
    "static-versus-usage comparison"
  ],
  "prohibited_evidence": [
    "api_key",
    "authorization_header",
    "environment_values",
    "real_user_data",
    "holdout_data",
    "internal_chain_of_thought",
    "reasoning_text",
    "unrelated_machine_information"
  ],
  "cost_term": "usage-derived cost estimate",
  "final_billed_cost_claim_allowed": false,
  "reasoning_usage_numbers_allowed": true,
  "reasoning_text_allowed": false
}
